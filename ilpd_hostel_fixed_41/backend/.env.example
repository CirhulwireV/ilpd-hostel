PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ilpdhotel
JWT_SECRET=<your_jwt_secret>
STRIPE_SECRET_KEY=<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<your_stripe_webhook_secret>
CLIENT_URL=http://localhost:3000
# Client cancellation deadline. Change this when ILPD approves a different policy.
CANCELLATION_DEADLINE_DAYS=7

# Refund/edit policy: 30 days per monthly rate for pro-rata adjustments.
REFUND_DAILY_DIVISOR=30
# Set to 0 to allow pending booking edits any time before room allocation.
BOOKING_EDIT_DEADLINE_HOURS=0

# ── REDIS (optional but recommended for multi-instance deployments) ───────────
# When set, Redis is used for:
#   1. Distributed rate limiting (consistent across all backend instances)
#   2. Response caching for rooms, rates, categories, location settings (60-120s TTL)
# Without Redis the app works fine on a single instance using in-memory fallbacks.
# Format: redis://:<password>@<host>:<port>  or  rediss:// for TLS (ElastiCache)
REDIS_URL=redis://localhost:6379
# AWS ElastiCache example:
# REDIS_URL=rediss://:<auth-token>@<cluster>.cache.amazonaws.com:6379

# Room images are stored as base64 data URLs in MongoDB by default (fine for
# up to ~128 rooms with 5 photos each). For thousands of rooms or high traffic:
#   1. Use AWS S3 + CloudFront: store only the S3 URL in the DB, not the image.
#   2. Enable MongoDB Atlas auto-scaling or upgrade to M10+ cluster.
#   3. Add Redis for rate-limit store when scaling to multiple backend instances.
#   4. Use AWS Elastic Beanstalk auto-scaling group (min 2, max N instances).
#   5. Enable MongoDB Atlas Atlas Search for full-text search on bookings/clients.
#   6. Archive old checked-out/cancelled bookings to a separate collection after
#      12 months to keep the active collection fast.
# Required for room image uploads. IAM access needs s3:PutObject on room-images/*.
# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here